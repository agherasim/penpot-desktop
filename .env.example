PENPOT_VERSION=2.14.3
PENPOT_PUBLIC_URI=http://localhost:9001
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
PENPOT_SECRET_KEY=

# penpot-cli (src/api-client) config.
# PENPOT_API_URL defaults to ${PENPOT_PUBLIC_URI}/api/rpc/command when unset.
# PENPOT_AUTH_TOKEN is a per-session login token, obtained via the Penpot UI/API — not a build secret.
PENPOT_AUTH_TOKEN=
