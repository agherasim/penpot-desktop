#!/bin/sh

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yaml"
EXAMPLE_FILE="$SCRIPT_DIR/.env.example"
VERSION_FILE="$SCRIPT_DIR/.version"
# Kept outside the app bundle so it survives DMG-based app updates
# (replacing Penpot.app wholesale would otherwise wipe it).
ENV_DIR="$HOME/Library/Application Support/Penpot"
ENV_FILE="$ENV_DIR/.env"
STARTUP_TIMEOUT=120

# Ensure Docker is in PATH when launched from Finder
export PATH="$HOME/.docker/bin:/usr/local/bin:$PATH"

SHIM_ID="app.penpot.desktop.launcher"
LSREGISTER=/System/Library/Frameworks/CoreServices.framework/Versions/A/Frameworks/LaunchServices.framework/Versions/A/Support/lsregister

# Applications folder to put the launcher in: explicit arg, else /Applications
# if writable, else ~/Applications.
apps_dir() {
  if [ -n "$1" ]; then
    echo "$1"
  elif [ -w /Applications ]; then
    echo /Applications
  else
    echo "$HOME/Applications"
  fi
}

is_shim() {
  [ "$(plutil -extract CFBundleIdentifier raw "$1/Contents/Info.plist" 2>/dev/null)" = "$SHIM_ID" ]
}

# install-app: write a tiny launcher bundle into the Applications folder that
# execs this app by a version-stable path. A Finder alias or symlink would
# resolve to the versioned Homebrew Cellar dir and break after upgrade+cleanup.
case "$1" in
  install-app)
    if command -v brew >/dev/null 2>&1 && BREW_PREFIX="$(brew --prefix --installed penpot-desktop 2>/dev/null)"; then
      TARGET_APP="$BREW_PREFIX/Penpot.app"
    else
      TARGET_APP="$(cd "$SCRIPT_DIR/../.." && pwd)"
    fi
    DEST_DIR="$(apps_dir "$2")"
    SHIM="$DEST_DIR/Penpot.app"
    if [ "$(cd "$SHIM" 2>/dev/null && pwd)" = "$TARGET_APP" ]; then
      echo "Penpot.app is already installed in $DEST_DIR."
      exit 0
    fi
    if [ -e "$SHIM" ] && ! is_shim "$SHIM"; then
      echo "Error: $SHIM already exists and is not a Penpot launcher — remove it first."
      exit 1
    fi
    rm -rf "$SHIM"
    mkdir -p "$SHIM/Contents/MacOS" "$SHIM/Contents/Resources"
    cat > "$SHIM/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>$SHIM_ID</string>
    <key>CFBundleName</key>
    <string>Penpot</string>
    <key>CFBundleDisplayName</key>
    <string>Penpot</string>
    <key>CFBundleExecutable</key>
    <string>Penpot</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
</dict>
</plist>
EOF
    printf '#!/bin/sh\nexec "%s/Contents/MacOS/Penpot" "$@"\n' "$TARGET_APP" > "$SHIM/Contents/MacOS/Penpot"
    chmod +x "$SHIM/Contents/MacOS/Penpot"
    cp "$TARGET_APP/Contents/Resources/AppIcon.icns" "$SHIM/Contents/Resources/AppIcon.icns"
    "$LSREGISTER" -f "$SHIM"
    echo "Installed launcher: $SHIM -> $TARGET_APP"
    exit 0
    ;;
  uninstall-app)
    SHIM="$(apps_dir "$2")/Penpot.app"
    if is_shim "$SHIM"; then
      rm -rf "$SHIM"
      echo "Removed launcher: $SHIM"
    else
      echo "No Penpot launcher found at $SHIM."
    fi
    exit 0
    ;;
esac

# First run: no .env yet, so walk the user through setup.
if [ ! -f "$ENV_FILE" ]; then
  mkdir -p "$ENV_DIR"
  if [ -t 0 ]; then
    "$SCRIPT_DIR/setup.sh" "$ENV_FILE" "$EXAMPLE_FILE"
  else
    # Launched from Finder (no terminal attached) — open one to run setup interactively.
    echo "No configuration found — opening Terminal for first-run setup..."
    osascript -e "tell application \"Terminal\" to do script \"'$SCRIPT_DIR/setup.sh' '$ENV_FILE' '$EXAMPLE_FILE'\"" >/dev/null
    elapsed=0
    while [ ! -f "$ENV_FILE" ] && [ "$elapsed" -lt 300 ]; do
      sleep 2
      elapsed=$((elapsed + 2))
    done
  fi
  if [ ! -f "$ENV_FILE" ]; then
    echo "Error: setup did not complete — aborting."
    exit 1
  fi
fi

# Load .env so PENPOT_PUBLIC_URI and other variables are available
set -a
. "$ENV_FILE"
set +a

# The Penpot version is pinned in the committed .version file (single source of
# truth) and injected here, overriding anything a stale .env might carry. Without
# it, docker-compose falls back to ':latest', risking a DB-schema mismatch.
if [ -f "$VERSION_FILE" ]; then
  PENPOT_VERSION="$(tr -d '[:space:]' < "$VERSION_FILE")"
  export PENPOT_VERSION
fi
if [ -z "$PENPOT_VERSION" ]; then
  echo "Error: PENPOT_VERSION is not set (missing or empty $VERSION_FILE) — aborting to avoid pulling ':latest'."
  exit 1
fi

# Only enable Google login if both credentials are set — the backend fails
# to start if the flag is on with empty client-id/client-secret.
if [ -n "$GOOGLE_OAUTH_CLIENT_ID" ] && [ -n "$GOOGLE_OAUTH_CLIENT_SECRET" ]; then
  export PENPOT_GOOGLE_FLAG="enable-login-with-google"
else
  export PENPOT_GOOGLE_FLAG=""
fi

wait_for_healthy() {
  elapsed=0
  echo "Waiting for Penpot to become healthy..."
  while [ "$elapsed" -lt "$STARTUP_TIMEOUT" ]; do
    if [ "$(curl -s "$PENPOT_PUBLIC_URI/readyz" 2>/dev/null)" = "OK" ]; then
      echo "Penpot is ready."
      return 0
    fi
    sleep 2
    elapsed=$((elapsed + 2))
  done
  echo "Error: start timeout after ${STARTUP_TIMEOUT}s — Penpot did not become healthy."
  return 1
}

case "$1" in
  start)
    if docker compose -p penpot -f "$COMPOSE_FILE" ps --quiet 2>/dev/null | grep -q .; then
      echo "Penpot is already running."
      exit 0
    fi
    echo "Starting Penpot (version: $PENPOT_VERSION)..."
    docker compose -p penpot -f "$COMPOSE_FILE" up -d
    if wait_for_healthy; then
      open "$PENPOT_PUBLIC_URI"
    fi
    "$SCRIPT_DIR/PenpotMenuBar" &
    ;;
  stop)
    if docker compose -p penpot -f "$COMPOSE_FILE" ps --quiet 2>/dev/null | grep -q .; then
      echo "Stopping Penpot..."
      docker compose -p penpot -f "$COMPOSE_FILE" down
    else
      echo "Penpot is not running."
    fi
    # Stop the menu bar app if running
    MENUBAR_PID=$(pgrep -f "$SCRIPT_DIR/PenpotMenuBar" 2>/dev/null)
    if [ -n "$MENUBAR_PID" ]; then
      kill "$MENUBAR_PID" 2>/dev/null
    fi
    ;;
  status)
    HEALTH=$(curl -s -o /dev/null -w "%{http_code}" "$PENPOT_PUBLIC_URI/readyz" 2>/dev/null)
    if [ "$HEALTH" = "200" ] && [ "$(curl -s "$PENPOT_PUBLIC_URI/readyz" 2>/dev/null)" = "OK" ]; then
      echo "Penpot is running at $PENPOT_PUBLIC_URI"
    else
      echo "Penpot is not healthy or not running."
    fi
    MCP_HEALTH=$(curl -s -o /dev/null -w "%{http_code}" "http://localhost:4400/manifest.json" 2>/dev/null)
    if [ "$MCP_HEALTH" = "200" ]; then
      echo "MCP server is running (plugin: http://localhost:4400, server: http://localhost:4401)"
    else
      echo "MCP server is not running."
    fi
    ;;
  "")
    if docker compose -p penpot -f "$COMPOSE_FILE" ps --quiet 2>/dev/null | grep -q .; then
      echo "Penpot is already running."
      exit 0
    fi
    echo "Starting Penpot (version: $PENPOT_VERSION)..."
    docker compose -p penpot -f "$COMPOSE_FILE" up -d
    if wait_for_healthy; then
      open "$PENPOT_PUBLIC_URI"
    fi
    "$SCRIPT_DIR/PenpotMenuBar" &
    ;;
  *)
    echo "Usage: $0 {start|stop|status|install-app [dir]|uninstall-app [dir]}"
    exit 1
    ;;
esac
